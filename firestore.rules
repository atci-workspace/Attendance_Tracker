rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function canUsePortal() {
      return isAuthenticated();
    }

    function isMainAdmin() {
      return isAuthenticated() &&
        request.auth.uid == '5vQbogx38YO3CeQMA2TvMgzN2zt2';
    }

    function isSelf(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /attendance/{docId} {
      allow read: if canUsePortal();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if canUsePortal();
      allow update: if canUsePortal() && (isSelf(uid) || isMainAdmin());
      allow create: if canUsePortal() && isSelf(uid);
      allow delete: if isMainAdmin();
    }

    match /teamMembers/{docId} {
      allow read: if true;
      allow write: if isMainAdmin();
    }

    match /emailWhitelist/{emailKey} {
      allow read: if canUsePortal();
      allow write: if isMainAdmin();
    }

    match /admins/{uid} {
      allow read, write: if isMainAdmin();
    }

    match /adminSecrets/{id} {
      allow read, write: if isMainAdmin();
    }

    match /auditLogs/{id} {
      allow create: if canUsePortal();
      allow read: if isMainAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
